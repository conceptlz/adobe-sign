# Library code at level 8. Tests run separately at level 6 (phpstan-tests.neon.dist):
# generated getters are nullable, and null-chains in assertions are fine there.
parameters:
    level: 8
    paths:
        - src
    excludePaths:
        # Generated by Jane, never hand-edited; GeneratedModelsContractTest pins its shape instead.
        - src/Generated
